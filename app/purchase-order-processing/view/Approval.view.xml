<mvc:View
    controllerName="purchaseorderprocessing.controller.Approval"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        showHeader="false"
        class="pageBackground">

        <content>

            <VBox
                class="sapUiSmallMargin">


                <!-- =====================================================
                     APPLICATION TOOLBAR
                     ===================================================== -->

                <Toolbar
                    class="appToolbar">

                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press=".onBack"/>

                    <Title
                        text="Approvals"/>

                    <ToolbarSpacer/>

                    <Button
                        icon="sap-icon://refresh"
                        type="Transparent"
                        tooltip="Refresh"
                        press=".onRefresh"/>

                    <Avatar
                        initials="SP"
                        displaySize="XS"/>

                </Toolbar>


                <!-- =====================================================
                     PAGE HEADER
                     ===================================================== -->

                <Toolbar>

                    <Title
                        text="Purchase Order Approvals"
                        level="H1"/>

                    <ToolbarSpacer/>

                    <ObjectStatus
                        text="{approval>/pendingCount} Pending"
                        state="Warning"/>

                </Toolbar>


                <!-- =====================================================
                     APPROVAL TABS
                     ===================================================== -->

                <IconTabBar
                    selectedKey="pending"
                    select=".onTabSelect">


                    <items>


                        <!-- =================================================
                             PENDING
                             ================================================= -->

                        <IconTabFilter
                            key="pending"
                            text="Pending"
                            icon="sap-icon://pending">

                            <Table
                                id="approvalTable"
                                items="{approval>/items}"
                                busy="{approval>/loading}"
                                growing="true"
                                growingThreshold="20"
                                noDataText="No purchase orders are pending approval.">


                                <columns>

                                    <Column>
                                        <Text
                                            text="PO Number"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Supplier"/>
                                    </Column>

                                    <Column
                                        hAlign="End">
                                        <Text
                                            text="Amount"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Created By"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Created On"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Action"/>
                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem>

                                        <cells>


                                            <!-- PO -->

                                            <Link
                                                text="{approval>poNumber}"
                                                press=".onPOPress"/>


                                            <!-- Supplier -->

                                            <Text
                                                text="{approval>supplier}"/>


                                            <!-- Amount -->

                                            <ObjectNumber
                                                number="{approval>amount}"
                                                unit="₹"/>


                                            <!-- Created By -->

                                            <Text
                                                text="{approval>createdBy}"/>


                                            <!-- Created On -->

                                            <Text
                                                text="{approval>createdOn}"/>


                                            <!-- Actions -->

                                            <HBox>

                                                <Button
                                                    text="Approve"
                                                    icon="sap-icon://accept"
                                                    type="Accept"
                                                    press=".onApprove"/>

                                                <Button
                                                    text="Reject"
                                                    icon="sap-icon://decline"
                                                    type="Reject"
                                                    class="sapUiTinyMarginBegin"
                                                    press=".onReject"/>

                                            </HBox>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </IconTabFilter>


                        <!-- =================================================
                             APPROVED
                             ================================================= -->

                        <IconTabFilter
                            key="approved"
                            text="Approved"
                            icon="sap-icon://accept">

                            <Table
                                items="{approval>/approved}"
                                growing="true"
                                growingThreshold="20"
                                noDataText="No approved purchase orders.">


                                <columns>

                                    <Column>
                                        <Text
                                            text="PO Number"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Supplier"/>
                                    </Column>

                                    <Column
                                        hAlign="End">
                                        <Text
                                            text="Amount"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Approver"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Comments"/>
                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem>

                                        <cells>

                                            <Link
                                                text="{approval>poNumber}"
                                                press=".onPOPress"/>

                                            <Text
                                                text="{approval>supplier}"/>

                                            <ObjectNumber
                                                number="{approval>amount}"
                                                unit="₹"/>

                                            <Text
                                                text="{approval>approver}"/>

                                            <Text
                                                text="{approval>comments}"
                                                wrapping="true"/>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </IconTabFilter>


                        <!-- =================================================
                             REJECTED
                             ================================================= -->

                        <IconTabFilter
                            key="rejected"
                            text="Rejected"
                            icon="sap-icon://decline">

                            <Table
                                items="{approval>/rejected}"
                                growing="true"
                                growingThreshold="20"
                                noDataText="No rejected purchase orders.">


                                <columns>

                                    <Column>
                                        <Text
                                            text="PO Number"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Supplier"/>
                                    </Column>

                                    <Column
                                        hAlign="End">
                                        <Text
                                            text="Amount"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Approver"/>
                                    </Column>

                                    <Column>
                                        <Text
                                            text="Rejection Comment"/>
                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem>

                                        <cells>

                                            <Link
                                                text="{approval>poNumber}"
                                                press=".onPOPress"/>

                                            <Text
                                                text="{approval>supplier}"/>

                                            <ObjectNumber
                                                number="{approval>amount}"
                                                unit="₹"/>

                                            <Text
                                                text="{approval>approver}"/>

                                            <Text
                                                text="{approval>comments}"
                                                wrapping="true"/>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </IconTabFilter>

                    </items>

                </IconTabBar>

            </VBox>

        </content>

    </Page>

</mvc:View>